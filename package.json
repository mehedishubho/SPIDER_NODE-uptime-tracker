{
  "name": "next-redux-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3007",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "pnpm exec prisma generate && NODE_OPTIONS=\"--max_old_space_size=2048\" next build && pnpm exec tsup",
    "start": "next start -p 3007",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:resilience": "docker compose -f docker-compose.test.yml up -d --wait && pnpm exec tsup && vitest run --config vitest.config.resilience.ts",
    "rehearse:migrations": "node scripts/rehearse-migrations.mjs",
    "schema:gate": "node scripts/schema-gate.mjs",
    "worker:boundary": "node scripts/check-worker-boundary.mjs",
    "verify": "docker compose -f docker-compose.test.yml up -d --wait && pnpm lint && pnpm typecheck && pnpm test && pnpm schema:gate && pnpm worker:boundary && pnpm build && pnpm test:e2e"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@lottiefiles/dotlottie-react": "^0.17.6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^2.9.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "6.3.4",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hugeicons-react": "^0.4.0",
    "ioredis": "^6.0.0",
    "js-cookie": "^3.0.8",
    "motion": "^12.23.24",
    "next": "^16.0.10",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.22.0",
    "pino": "10.3.1",
    "radix-ui": "^1.6.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "sonner": "^2.0.7",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.3.1",
    "undici": "8.10.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/redux-persist": "^4.0.0",
    "@types/uuid": "^10.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "author": "Md. Rakibul Islam (Junior Frontend Developer)",
  "license": "MIT"
}
