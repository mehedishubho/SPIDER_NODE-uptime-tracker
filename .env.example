# SpiderNode Uptime Tracker — environment variable contract.
# Names and purposes ONLY. Never commit real values, hostnames, or tokens.
# Copy to .env and fill in per environment.

# --- Database -----------------------------------------------------------
# PostgreSQL connection string (Neon-compatible) used by the ONE Drizzle
# client (src/db — the shared pg pool, DRZ-05).
DATABASE_URL=

# --- Auth (Better Auth) ----------------------------------------------------
# Canonical public base URL for Better Auth: OAuth callbacks, the /api/auth
# catch-all (src/app/api/auth/[...all]/route.ts) and the email link domain
# (src/lib/email/render.ts).
BETTER_AUTH_URL=
# Google OAuth app credentials (src/lib/auth.ts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth app credentials (src/lib/auth.ts).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the Better Auth session cookies and the cookieCache JWT
# (src/lib/auth.ts; throw-early read).
BETTER_AUTH_SECRET=
# Dated /login notice window (AUTH-06/D-02): RETIRED at the 07-08 deletion
# release (D-05 delete-after-use) — the strip's component, env predicate, and
# both env entries are gone; the remnant gate keeps the names out.
# Comma-separated admin roster. Read ONLY by scripts/seed-admin-roles.mjs
# at cutover-migration time (D-08/D-12): missing/empty/zero-match aborts
# the seed without granting (D-09). No runtime role after the migration —
# ongoing grants are runbook SQL (D-11). Roster = the operator account
# email (D-10).
ADMIN_EMAILS=
# Worker :9090 Bull Board allowlist, IPs/CIDRs comma-separated
# (D-17 — gate 1 in front of the queue UI mounted in 07-05; the feedback
# API is NOT allowlist-gated). Empty/unset = allow nobody.
ADMIN_IP_ALLOWLIST=

# --- Telegram alerts ------------------------------------------------------
# Bot token used to send alert messages and poll the connect webhook
# (src/lib/telegram.ts).
TELEGRAM_BOT_TOKEN=
# Bot username exposed to the browser for the "connect to Telegram" deep
# link (src/app/api/telegram/...).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Webhook origin auth (X-Telegram-Bot-Api-Secret-Token header,
# src/app/api/telegram/webhook/route.ts) -- requires the one-time setWebhook
# registration with secret_token (runbook §4b; rotation = re-run setWebhook).
TELEGRAM_WEBHOOK_SECRET=

# --- Email (SMTP) ----------------------------------------------------------
# SMTP transport credentials for the queue worker's transactional email
# provider (src/lib/email — provider interface selected by EMAIL_PROVIDER
# below; the legacy in-request transport src/lib/mail.ts was deleted at the
# Phase-6 deletion release).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Transactional email transport for the queue worker (src/lib/email):
# "smtp" (default when unset) or "console" (dev: prints the full dump to
# stdout). An unknown value fails loud at worker boot (EML-01/D-11).
EMAIL_PROVIDER=smtp

# --- Cloudinary (profile avatar uploads) -----------------------------------
# Cloudinary credentials (src/app/api/user/profile/route.ts).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Client API base URL selection (src/redux/api/baseApi.ts) --------------
# "production" or anything else; selects which base URL client-side fetches
# use.
NEXT_PUBLIC_ENV=
# API base URL used by the client when NEXT_PUBLIC_ENV=production.
NEXT_PUBLIC_BASE_URL=
# API base URL used by the client outside production.
NEXT_PUBLIC_DEV_BASE_URL=

# --- Platform-provided runtime flags (read by code, set by the platform) ----
# Framework mode.
NODE_ENV=

# --- Redis (rate limiting) -----------------------------------------------
# Redis client backing the rate limiter (src/lib/redis.ts); required at
# module load. Dev: redis://localhost:6390 when the docker-compose.test.yml
# stack is up -- dev without Redis fails open by design. Prod:
# redis://:pass@127.0.0.1:6379 (requirepass per the runbook).
REDIS_URL=
# Localhost-only test contract (docker-compose.test.yml redis :6390);
# vitest.config.ts carries the same value as the canonical fallback.
TEST_REDIS_URL=

# --- Worker (dedicated monitoring worker, Phase 4) -------------------------
# Dark-launch master switch (D-16): "false" (default) skips upserting the
# check-tick and maintenance job schedulers at worker boot -- everything else
# (queue consumers, health endpoints) runs live. Phase 5 flips this to "true"
# as the cutover lever (src/worker/index.ts).
WORKER_SCHEDULER_ENABLED=
# Loopback health port serving /healthz, /readyz and /metrics.json
# (src/worker/health.ts); the runbook pins 9090 (D-13).
WORKER_HEALTH_PORT=
# pino log level for the worker; JSON lines on stdout only
# (src/worker/logger.ts, D-14).
WORKER_LOG_LEVEL=

# --- Worker dead-man switches (healthchecks.io, Phase 5 add-release) -------
# Optional healthchecks.io ping URLs, pinged by the worker scheduler tick
# (src/worker/scheduler.ts): each check is pinged at most once per tick
# (30 s tick = 2 pings/min, under hc.io's 5/min cap) and a ping is SKIPPED
# when the variable is unset -- nothing pages, nothing errors. The wiring
# lands with plan 05-02 in this same add-release and goes live at
# window-open when the scheduler unpauses (runbook §4a step 5; graces
# 10/5/30 min heartbeat/outbox/memory per D-25).
# Worker heartbeat: pinged on tick completion, /fail on tick error
# (WRK-09; supersedes the legacy HC_PING_URL cron check at the deletion
# release).
WORKER_HC_PING_URL=
# Outbox relay health: pinged only while the oldest unsent outbox row is
# under the age threshold (OBS-03; a backed-up outbox stops pinging and
# pages after its grace).
WORKER_OUTBOX_HC_PING_URL=
# Redis memory health: pinged only while used memory stays below 70% of
# maxmemory (runbook §3c, D-24 -- supersedes the VPS-cron script form).
WORKER_MEMORY_HC_PING_URL=
