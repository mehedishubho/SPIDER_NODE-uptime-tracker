# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# playwright artifacts
/test-results/

# next.js
/.next/
/out/

# production
/build

# worker bundle output (tsup, 04-01/D-06): built by `pnpm build` on the dev
# machine and shipped inside the deploy tarball — never committed
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# test env contract (localhost-only URLs, no secrets) — committable
!.env.test

# production snapshot dumps for migration rehearsals (D-11): fresh pg_dump
# copies of live production restored into throwaway containers — PII-bearing,
# never committed
.snapshots/

# schema-gate throwaway introspection output (03-07): deleted by
# scripts/schema-gate.mjs on every exit path; ignored so a killed run can
# never leak generated artifacts into a commit
/.tmp-gate/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo

# AI Agents and Tools
.gemini/
.agents/

# Local project notes (not for version control)
project_analysis.md

# GSD planning toolchain scratch (02-01 hygiene nomination, actioned 2026-10-02):
# research-fingerprint cache + orchestrator tmp files are generated, never committed
.planning/research/.cache/
.planning/tmp/
